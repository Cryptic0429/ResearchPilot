# Track only the application, launchers and required licenses.
/*
!/.gitignore
!/README.md
!/assets/
!/LICENSE
!/run.py
!/start.bat
!/start.command
!/researchpilot/
!/static/

# Keep local state, secrets and generated files out of source control.
**/.researchpilot/
**/.env
**/.env.*
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/node_modules/
.DS_Store
*.log
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.pem
*.key

# Development and verification material is local only.
**/tests/
**/test_*.py
**/*_test.py
**/*.test.js
**/*.spec.js
